# Configuration du serveur
PORT=5000
NODE_ENV=development

# Configuration JWT
JWT_SECRET=dev_secret_key_change_in_production_please_use_a_long_random_string
JWT_EXPIRES_IN=24h

# Configuration de la base de données (SQLite pour dev)
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/app.db

# Configuration de l'upload d'images
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880 # 5MB
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Configuration CORS
CORS_ORIGIN=http://localhost:5173
