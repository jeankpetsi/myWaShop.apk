# Configuration du serveur
PORT=5000
NODE_ENV=development

# Configuration JWT
JWT_SECRET=votre_secret_jwt_ici_changez_en_production
JWT_EXPIRES_IN=24h

# Configuration de la base de données (SQLite pour dev, facilement changeable pour PostgreSQL)
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/app.db

# Pour PostgreSQL en production:
# DB_TYPE=postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_USERNAME=postgres
# PG_PASSWORD=your_password
# PG_DATABASE=sellercatalog

# Configuration de l'upload d'images
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880 # 5MB
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Configuration CORS
CORS_ORIGIN=http://localhost:5173
